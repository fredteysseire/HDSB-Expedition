# =========================================================
# HDSB Expédition, configuration Apache (hébergement mutualisé)
# =========================================================
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Une seule version du domaine : https://hdsb-xp.com (https, sans www).
# Prérequis : certificat SSL actif pour hdsb-xp.com ET www.hdsb-xp.com chez l'hébergeur,
# sinon commenter ces trois lignes le temps de l'activer.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^hdsb-xp\.com$ [NC]
RewriteRule ^ https://hdsb-xp.com%{REQUEST_URI} [R=301,L,NE]

# Doublon /index.html -> / (THE_REQUEST évite la boucle de redirection sur la résolution interne).
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://hdsb-xp.com/ [R=301,L]
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache navigateur : ressources statiques longues, pages HTML courtes
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
